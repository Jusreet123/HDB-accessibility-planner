# Copy this file to backend/.env and fill in the real values.
# Never commit .env: it is listed in .gitignore.

# ---- Aiven MySQL ----
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=defaultdb
# Locally: the name of the CA file saved in backend/ (e.g. ca.pem).
# On Render: paste the whole certificate, starting with -----BEGIN CERTIFICATE-----
DB_SSL_CA=ca.pem

# ---- MongoDB Atlas ----
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/

# ---- Sessions (at least 32 random characters) ----
SESSION_SECRET=replace-with-a-long-random-string-of-32-plus-characters

# ---- Google sign-in (optional; email and password sign-in works without it) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ---- Server ----
PORT=3000
# Set to production on Render (turns on secure cookies)
NODE_ENV=development
